@font-face{font-family:Vazirmatn;font-weight:400;src:url("fonts/vazirmatn_regular.ttf") format("truetype")}
@font-face{font-family:Vazirmatn;font-weight:500;src:url("fonts/vazirmatn_medium.ttf") format("truetype")}
@font-face{font-family:Vazirmatn;font-weight:700;src:url("fonts/vazirmatn_bold.ttf") format("truetype")}
*{box-sizing:border-box}html,body{margin:0;height:100%;color:#f1ecfa;font-family:Vazirmatn,Tahoma,"Segoe UI",sans-serif;overflow:hidden}body{background:#17131f url("background.png") center center / cover no-repeat fixed;position:relative}body::before{content:"";position:fixed;inset:0;background:linear-gradient(180deg,rgba(9,5,15,.30),rgba(9,5,15,.46));pointer-events:none;z-index:0}body{display:flex;flex-direction:column}main{position:relative;z-index:1;flex:1;min-height:0;overflow-y:auto}nav{position:relative;z-index:2;display:flex;background:rgba(29,22,41,.94);border-top:1px solid #2e2442}[hidden]{display:none!important}main{flex:1;min-height:0;overflow-y:auto}.screen{padding:20px;display:flex;flex-direction:column;gap:14px;min-height:100%}h1{font-size:20px;margin:0}h2{font-size:16px;margin:8px 0 0}p{margin:0}.muted{color:#b7accb}.small{font-size:13px}.tiny{font-size:12px;margin:0}.center{display:flex;flex-direction:column;align-items:center;gap:14px;padding-top:30px;flex:1}.big-text{font-size:16px}.big{position:relative;z-index:1;width:150px;height:150px;border-radius:50%;border:0;background:#7c3aed;color:#fff;font-size:22px;font-weight:700;font-family:inherit;box-shadow:0 0 0 12px #2a1f45,0 0 0 24px #211a35;cursor:pointer;transition:transform .18s ease,filter .18s ease,box-shadow .18s ease}.big:hover{transform:translateY(-3px) scale(1.025);filter:brightness(1.08);box-shadow:0 0 0 12px #30224f,0 0 0 24px #251b3b,0 12px 32px rgba(124,58,237,.25)}.big:active{transform:scale(.98)}button{font-family:inherit;cursor:pointer}button:disabled{cursor:wait;opacity:.6}.btn{min-height:44px;padding:0 18px;border-radius:10px;font-size:15px;font-weight:500;border:0;background:#7c3aed;color:#fff;transition:transform .16s ease,filter .16s ease,box-shadow .16s ease,border-color .16s ease}.btn:hover:not(:disabled){transform:translateY(-2px);filter:brightness(1.08);box-shadow:0 7px 18px rgba(0,0,0,.22)}.btn:active:not(:disabled){transform:translateY(0) scale(.98);box-shadow:none}.btn.ghost{background:transparent;border:1px solid #6d5a9c}.btn.ghost:hover:not(:disabled){border-color:#a78bfa;background:#251c38}.btn.full{width:100%}.grow{flex:1}.small-btn{min-height:38px;padding:0 12px;font-size:13px}.card{background:#211a30;border:1px solid #2e2442;border-radius:14px;padding:12px 14px;display:flex;align-items:center;gap:10px;transition:border-color .18s ease,transform .18s ease}.card:hover{border-color:#49366a}.card.col{flex-direction:column;align-items:flex-start}.addr{flex:1;direction:ltr;text-align:left;font-size:14px;overflow:hidden;text-overflow:ellipsis}.badge{background:#33284d;color:#e4dafc;border-radius:6px;padding:2px 8px;font-size:12px;font-weight:600;direction:ltr}.row{display:flex;gap:8px}input{flex:1;min-width:0;min-height:44px;border-radius:10px;border:1px solid #6d5a9c;background:#0f0b16;color:#f1ecfa;padding:0 12px;font-size:15px;font-family:inherit;text-align:left;transition:border-color .16s ease,box-shadow .16s ease}input:focus,select:focus{outline:none;border-color:#a78bfa;box-shadow:0 0 0 3px rgba(167,139,250,.12)}.list{display:flex;flex-direction:column;gap:8px}.item{display:flex;align-items:center;gap:10px;background:#211a30;border:1px solid #2e2442;border-radius:12px;padding:8px 12px;min-height:56px;transition:transform .16s ease,border-color .16s ease,background .16s ease,box-shadow .16s ease}.item:hover{transform:translateY(-2px);border-color:#49366a;background:#241c34;box-shadow:0 8px 20px rgba(0,0,0,.16)}.item.bad{opacity:.6}.dot{width:12px;height:12px;border-radius:50%;flex:none}.dot.ok{background:#34d399;box-shadow:0 0 9px rgba(52,211,153,.35)}.dot.bad{background:#f87171}.dot.wait{background:#9ca3af}.info{flex:1;min-width:0}.host{direction:ltr;font-size:13px;display:inline-block;max-width:100%;overflow:hidden;text-overflow:ellipsis;vertical-align:middle}.stats{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:2px}.speed{font-size:12px;font-weight:700;color:#67e8f9;direction:ltr}.del{min-width:44px;min-height:44px;background:none;border:0;color:#f0a1a1;font-size:20px;transition:transform .16s ease,color .16s ease}.del:hover{transform:scale(1.15);color:#fecaca}.site{flex:1;direction:ltr;text-align:left}pre{background:#0f0b16;border-radius:10px;padding:10px;font-size:11px;white-space:pre-wrap;max-height:180px;overflow:auto;margin:0}nav button{flex:1;background:none;border:0;border-top:3px solid transparent;color:#b7accb;font-size:14px;min-height:52px;transition:color .16s ease,background .16s ease,border-color .16s ease,transform .16s ease}nav button:hover{background:#241b32;color:#e9e0f5;transform:translateY(-1px)}nav button:active{transform:translateY(1px)}nav button.active{border-top-color:#a78bfa;color:#f1ecfa;font-weight:700}#toast{position:fixed;bottom:64px;left:20px;right:20px;background:#33284d;color:#f1ecfa;padding:10px 14px;border-radius:10px;font-size:13px;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.28);z-index:20}.orb{position:relative;width:150px;height:150px;margin:34px 0}.wave{position:absolute;inset:0;border-radius:50%;background:rgba(167,139,250,.30);opacity:0;pointer-events:none}.orb.live .wave{animation:wave 3s ease-out infinite}.orb.live .w2{animation-delay:1.5s}.spin{position:absolute;inset:-18px;border-radius:50%;border:4px solid transparent;border-top-color:#c4b5fd;border-right-color:#7c3aed;opacity:0;pointer-events:none}.orb.busy .spin{opacity:1;animation:spin 1s linear infinite}.orb.busy .big{animation:pulse 1.4s ease-in-out infinite}@keyframes wave{0%{transform:scale(1);opacity:.55}100%{transform:scale(2.1);opacity:0}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes pulse{50%{transform:scale(.96)}}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.refresh-btn{white-space:nowrap;min-height:40px;font-size:13px}.setting-list{display:flex;flex-direction:column;gap:8px}.setting{position:relative;display:flex;align-items:center;gap:12px;background:#211a30;border:1px solid #2e2442;border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color .16s ease,background .16s ease,transform .16s ease,box-shadow .16s ease}.setting:hover{border-color:#49366a;background:#241c34;transform:translateY(-1px);box-shadow:0 6px 14px rgba(0,0,0,.12)}.setting input[type=checkbox]{position:absolute;opacity:0;pointer-events:none}.setting-text{display:flex;flex-direction:column;gap:3px;flex:1}.setting-text strong{font-size:14px}.setting-text small{font-size:11px;color:#a99dbc;line-height:1.5}.switch{width:42px;height:24px;border-radius:99px;background:#403452;position:relative;flex:none;transition:background .2s ease}.switch:after{content:"";position:absolute;width:18px;height:18px;top:3px;left:3px;border-radius:50%;background:#d9d0e6;transition:transform .2s ease}.setting input[type=checkbox]:checked + .switch{background:#7c3aed}.setting input[type=checkbox]:checked + .switch:after{transform:translateX(18px);background:#fff}.select-setting{cursor:default}.select-setting select{min-width:70px;min-height:38px;background:#0f0b16;color:#f1ecfa;border:1px solid #6d5a9c;border-radius:9px;padding:0 8px;font-family:inherit}.radio-setting{cursor:pointer}.radio-setting input[type=radio]{position:absolute;opacity:0;pointer-events:none}.radio{width:20px;height:20px;border:2px solid #6d5a9c;border-radius:50%;position:relative;flex:none}.radio-setting input[type=radio]:checked + .radio{border-color:#a78bfa}.radio-setting input[type=radio]:checked + .radio:after{content:"";position:absolute;inset:4px;border-radius:50%;background:#a78bfa}.tray-card{display:flex;gap:12px;align-items:center;background:linear-gradient(135deg,#241b36,#1f192d);border:1px solid #3b2c55;border-radius:14px;padding:13px}.tray-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:#33234f;color:#a78bfa;font-size:20px;flex:none}.advanced{background:#211a30;border:1px solid #2e2442;border-radius:12px;overflow:hidden}.advanced summary{cursor:pointer;padding:12px 14px;font-size:14px;font-weight:700;transition:background .16s ease}.advanced summary:hover{background:#241c34}.advanced-body{padding:0 12px 12px}.advanced-body pre{max-height:180px}@media (prefers-reduced-motion:reduce){.orb .wave,.orb .spin,.orb .big,.btn,.item,.setting,nav button{animation:none!important;transition:none!important}
}
