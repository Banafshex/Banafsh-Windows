{
  "name": "banafsh",
  "version": "0.1.9",
  "description": "Banafsh for Windows",
  "main": "main.js",
  "author": "BANAFSHX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.banafshx.banafsh",
    "productName": "Banafsh",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png",
      "!**/*.bak"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico",
      "artifactName": "Banafsh-${version}-portable.exe"
    },
    "artifactName": "Banafsh-${version}-portable.exe"
  }
}
